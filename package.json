{
  "name": "spem-player",
  "private": true,
  "version": "2.8.3",
  "description": "Helping singers learn Thomas Tallis Spem in alium",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spem/pwa dev",
    "build": "pnpm --filter @spem/pwa build",
    "build:scores": "pnpm --filter @spem/scores build",
    "build:ohm": "pnpm --filter @spem/pwa build:ohm",
    "preview": "pnpm --filter @spem/pwa preview",
    "test": "pnpm --filter @spem/pwa test",
    "test:unit": "pnpm --filter @spem/pwa test:unit",
    "test:lilypond": "pnpm --filter @spem/scores test:integration",
    "test:monitor": "pnpm --filter @spem/monitor test",
    "test:watch": "pnpm --filter @spem/pwa test:watch",
    "test:coverage": "pnpm --filter @spem/pwa test:coverage",
    "e2e": "pnpm --filter @spem/pwa e2e",
    "check": "pnpm --filter @spem/pwa check && pnpm --filter @spem/monitor lint",
    "ci": "pnpm run check && pnpm run build && pnpm run test:unit",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "author": "Mark Wainwright",
  "packageManager": "pnpm@11.5.3",
  "license": "MIT"
}
