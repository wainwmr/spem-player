{
  "name": "@spem/pwa",
  "private": true,
  "version": "2.8.4",
  "description": "Helping singers learn Thomas Tallis Spem in alium",
  "type": "module",
  "dependencies": {
    "ohm-js": "^17.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ohm-js/cli": "^2.0.1",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.1"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "prebuild": "pnpm run build:ohm",
    "build:ohm": "npx ohm generateBundles --withTypes src/ohmjs/ly-grammar.ohm",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "pnpm run build:ohm && pnpm run check:unused && pnpm run check:format && pnpm run check:lint && pnpm run check:types && pnpm run check:deps",
    "check:lint": "eslint . --max-warnings 0",
    "check:format": "prettier --check src/",
    "check:types": "tsc --noEmit",
    "check:deps": "depcruise src/ts/*.ts index.ts",
    "check:unused": "knip",
    "fix:lint": "eslint . --fix",
    "fix:format": "prettier --write src/",
    "ci": "pnpm run check && pnpm run build && pnpm run test:unit"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,scss,css,html,md}": [
      "prettier --write"
    ]
  },
  "author": "Mark Wainwright",
  "packageManager": "pnpm@11.5.3",
  "license": "MIT"
}
